---
Language: C
BasedOnStyle: LLVM

# --- indentation ---
IndentWidth: 2
TabWidth: 2
UseTab: Never
ContinuationIndentWidth: 4

# --- line length ---
ColumnLimit: 80

# --- braces (K&R: opening brace on same line) ---
BreakBeforeBraces: Attach

# --- short constructs ---
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# --- spacing ---
SpaceAfterCStyleCast: false
SpaceBeforeParens: ControlStatements
SpaceInEmptyParentheses: false
SpacesInAngles: Never
SpacesInParentheses: false
SpacesInSquareBrackets: false

# --- pointer alignment ---
PointerAlignment: Right

# --- alignment ---
# Align trailing /* comments */ within the same block (good for palette)
AlignTrailingComments: true
# No forced column padding for declarations or assignments
AlignConsecutiveDeclarations: false
AlignConsecutiveAssignments: false
AlignConsecutiveMacros: false
# Array-of-structs: no column padding
AlignArrayOfStructures: None

# --- binary operators ---
BreakBeforeBinaryOperators: None

# --- includes ---
# Do NOT reorder #include lines (dwm header order matters)
SortIncludes: Never
IncludeBlocks: Preserve

# --- comments ---
# Keep hand-formatted block comments intact
ReflowComments: false

# --- empty lines ---
MaxEmptyLinesToKeep: 1
KeepEmptyLinesAtTheStartOfBlocks: false

# --- macros ---
# Treat TAGKEYS and SHCMD as statement-level macros so clang-format
# does not try to reformat their internal structure.
StatementMacros:
  - TAGKEYS
  - SHCMD
